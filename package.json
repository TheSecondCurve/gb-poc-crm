{
  "name": "xhs-matrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "小红书账号矩阵经营管理系统",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js & vite; wait",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "node server/db/migrate-cli.js",
    "check:scenarios": "node scripts/check-scenarios.mjs",
    "check:drift": "node scripts/check-drift.mjs"
  },
  "dependencies": {
    "argon2": "^0.43.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.4",
    "fastify": "^5.5.0",
    "lucide-react": "^1.44.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.33.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "argon2@0.43.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
